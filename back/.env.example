# Base de données PostgreSQL (Render, ou locale)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&connect_timeout=30&pool_timeout=30"

# Authentification
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Serveur
PORT=3001

# URL(s) du frontend autorisée(s) en CORS (séparées par des virgules)
FRONT_URL="http://localhost:3000"

# Email (SMTP) — laisser vide en dev pour utiliser Ethereal automatiquement
MAIL_HOST=""
MAIL_PORT=587
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="BiblioSmart <no-reply@bibliosmart.local>"

# Notifications push (VAPID) — générer avec `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@bibliosmart.local"
